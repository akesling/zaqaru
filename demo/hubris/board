# The board on this container's bench, which zaqaru's kernel runs: an
# STM32H753 Nucleo-144, its flash the Hubris image. Its debug probe is on
# USB, a CMSIS-DAP probe Humility finds by itself; `probe` is where a GDB
# server on the same debug port listens too, for a debugger that speaks GDB.
chip   stm32h753
image  /hubris/final.bin
probe  127.0.0.1:3333
