# The board on this container's bench, which zaqaru's kernel runs: an
# STM32G031 Nucleo, its flash the Hubris image. Its debug probe is on USB,
# a CMSIS-DAP probe Humility finds by itself; `probe` is where a GDB server
# on the same debug port listens too, for a debugger that speaks GDB.
chip   stm32g031
image  /hubris/final.bin
probe  127.0.0.1:3333
