@@ -0,0 +1,179 @@
+// This Source Code Form is subject to the terms of the Mozilla Public
+// License, v. 2.0. If a copy of the MPL was not distributed with this
+// file, You can obtain one at https://mozilla.org/MPL/2.0/.
+
+//! A core reached through a GDB remote serial protocol server, selected
+//! with `--probe gdb:HOST:PORT`.
+//!
+//! This is the probe for targets that have no debug probe at all -- an
+//! emulator, chiefly -- and so it asks a little more of the server than
+//! GDB itself does: memory reads and writes while the target runs (as
+//! a probe reads over the AHB-AP), and register numbers that are the
+//! DCRSR selectors of [`ARMRegister`] rather than GDB's own numbering.
+//! The target is left running on attach; [`Core::halt`] stops it.
+
+use anyhow::{Result, anyhow, bail};
+use humility::core::{Core, PreviousCpuState};
+use humility::log::{Logger, info};
+use humility_arch_arm::ARMRegister;
+use std::io::{Read, Write};
+use std::net::{TcpStream, ToSocketAddrs};
+
+/// The largest read sent as one `m` packet.
+const CHUNK: usize = 2048;
+
+pub struct GdbCore {
+    stream: TcpStream,
+    /// Bytes read past the end of the last packet.
+    pending: Vec<u8>,
+    halted: bool,
+}
+
+pub fn attach(address: &str, log: &Logger) -> Result<GdbCore> {
+    let addr = address
+        .to_socket_addrs()?
+        .next()
+        .ok_or_else(|| anyhow!("{address} does not resolve"))?;
+    // A plain blocking connection, with no socket timeouts: the server this
+    // exists for runs under kernels (zaqaru's, for one) that refuse
+    // SO_RCVTIMEO, and it answers every packet it is sent.
+    let stream = TcpStream::connect(addr)
+        .map_err(|e| anyhow!("can't connect to GDB server at {address}: {e}"))?;
+    stream.set_nodelay(true)?;
+    let mut core = GdbCore { stream, pending: vec![], halted: false };
+    core.command("qSupported")?;
+    info!(log, "attached to GDB server at {address}");
+    Ok(core)
+}
+
+impl GdbCore {
+    fn byte(&mut self) -> Result<u8> {
+        if self.pending.is_empty() {
+            let mut buf = [0; 4096];
+            let n = self.stream.read(&mut buf)?;
+            if n == 0 {
+                bail!("GDB server closed the connection");
+            }
+            self.pending.extend_from_slice(&buf[..n]);
+        }
+        Ok(self.pending.remove(0))
+    }
+
+    fn send(&mut self, payload: &str) -> Result<()> {
+        let sum = payload.bytes().fold(0u8, |a, b| a.wrapping_add(b));
+        self.stream.write_all(format!("${payload}#{sum:02x}").as_bytes())?;
+        Ok(())
+    }
+
+    /// The next packet from the server, acknowledged. Acks and anything
+    /// outside a packet are skipped.
+    fn packet(&mut self) -> Result<String> {
+        while self.byte()? != b'$' {}
+        let mut payload = vec![];
+        loop {
+            match self.byte()? {
+                b'#' => break,
+                b => payload.push(b),
+            }
+        }
+        let sum = [self.byte()?, self.byte()?];
+        let expected = u8::from_str_radix(std::str::from_utf8(&sum)?, 16)?;
+        let actual = payload.iter().fold(0u8, |a, b| a.wrapping_add(*b));
+        if expected != actual {
+            self.stream.write_all(b"-")?;
+            bail!("GDB packet checksum mismatch");
+        }
+        self.stream.write_all(b"+")?;
+        Ok(String::from_utf8(payload)?)
+    }
+
+    /// Sends a command and returns its reply. A stop reply arriving in
+    /// the meantime -- the target hit a breakpoint while running -- is
+    /// noted rather than mistaken for the answer.
+    fn command(&mut self, payload: &str) -> Result<String> {
+        self.send(payload)?;
+        loop {
+            let reply = self.packet()?;
+            if !payload.starts_with('?') && is_stop(&reply) {
+                self.halted = true;
+                continue;
+            }
+            if reply.starts_with('E') && reply.len() == 3 {
+                bail!("GDB server refused {payload}: {reply}");
+            }
+            return Ok(reply);
+        }
+    }
+}
+
+fn is_stop(reply: &str) -> bool {
+    (reply.starts_with('S') || reply.starts_with('T')) && reply.len() >= 3
+}
+
+fn unhex(s: &str) -> Result<Vec<u8>> {
+    if s.len() % 2 != 0 {
+        bail!("odd-length hex reply: {s}");
+    }
+    (0..s.len())
+        .step_by(2)
+        .map(|i| Ok(u8::from_str_radix(&s[i..i + 2], 16)?))
+        .collect()
+}
+
+impl Core for GdbCore {
+    fn read_8(&mut self, addr: u32, data: &mut [u8]) -> Result<()> {
+        for (i, chunk) in data.chunks_mut(CHUNK).enumerate() {
+            let at = addr.wrapping_add((i * CHUNK) as u32);
+            let bytes = unhex(&self.command(&format!("m{at:x},{:x}", chunk.len()))?)?;
+            if bytes.len() != chunk.len() {
+                bail!("short read at 0x{at:08x}");
+            }
+            chunk.copy_from_slice(&bytes);
+        }
+        Ok(())
+    }
+
+    fn read_reg(&mut self, reg: ARMRegister) -> Result<u32> {
+        let bytes = unhex(&self.command(&format!("p{:x}", reg as u32))?)?;
+        let bytes: [u8; 4] = bytes
+            .try_into()
+            .map_err(|_| anyhow!("bad register reply for {reg:?}"))?;
+        Ok(u32::from_le_bytes(bytes))
+    }
+
+    fn write_word_32(&mut self, addr: u32, data: u32) -> Result<()> {
+        self.write_8(addr, &data.to_le_bytes())
+    }
+
+    fn write_8(&mut self, addr: u32, data: &[u8]) -> Result<()> {
+        let hex: String = data.iter().map(|b| format!("{b:02x}")).collect();
+        match self.command(&format!("M{addr:x},{:x}:{hex}", data.len()))?.as_str() {
+            "OK" => Ok(()),
+            reply => bail!("write at 0x{addr:08x} failed: {reply}"),
+        }
+    }
+
+    fn halt(&mut self) -> Result<PreviousCpuState> {
+        if self.halted {
+            return Ok(PreviousCpuState::Halted);
+        }
+        self.stream.write_all(&[0x03])?;
+        loop {
+            if is_stop(&self.packet()?) {
+                break;
+            }
+        }
+        self.halted = true;
+        Ok(PreviousCpuState::Running)
+    }
+
+    fn run(&mut self) -> Result<PreviousCpuState> {
+        if !self.halted {
+            return Ok(PreviousCpuState::Running);
+        }
+        // A continue has no reply until the target next stops.
+        self.send("c")?;
+        self.halted = false;
+        Ok(PreviousCpuState::Halted)
+    }
+}
