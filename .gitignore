/target

# Local Claude Code configuration: personal to one machine, and the hook it
# registers. Committing either would hand every contributor a ban that is not
# theirs — and committing the settings without the script would leave a hook
# pointing at a file that is not in the clone.
.claude/settings.local.json
.claude/hooks/

# The debugger page's fixture: a module and a tape, made by web/fixture.sh.
/web/fixture
/web/demo
/_site
/web/brotli.wasm

# Builds for linux/amd64 from a non-Linux host, made in a container; see
# demo/hubris.
/target-linux
/target-profile
